# TEMPLATE ONLY - this file is committed to git. Never put real values here.
# Copy it to logic-app/.env, which is gitignored, and fill that in instead.
#
# Two different files are involved, so check which one you want:
#
#   logic-app/.env          read automatically by docker compose
#   logic-app/backend/.env  only for running the API directly, with
#                           `uvicorn --env-file .env` and no Docker
#
# Write values with no space after "=", or they are taken literally and a
# stray space ends up inside a password or an address.

# ---------------------------------------------------------------- Docker Compose

POSTGRES_PASSWORD=replace-with-a-unique-database-password

# "site" (or any value other than "open") requires students to create an
# account and gates Teacher studio by role. In "open" mode there is no sign-in
# at all and ANY visitor can open Teacher studio and read every answer key.
AUTH_MODE=site

# Required when AUTH_MODE is not "open" and DEMO_MODE is false: the first
# teacher account is created from these at startup. Without them the API
# refuses to start, because nobody could review or approve a question.
TEACHER_EMAIL=replace-with-the-first-teachers-address
TEACHER_PASSWORD=replace-with-at-least-twelve-characters

# Exactly what appears in the browser's address bar: scheme, host, and port if
# it is not the default. No trailing slash and no path -- the write guard
# compares it literally against the Origin header, and a mismatch refuses every
# write while reads keep working. A comma-separated list is accepted.
PUBLIC_ORIGIN=https://logic.your-domain.example

# Host port for the web container. Change it if something else is bound there.
WEB_PORT=3000

# Keep true in front of students. A Secure cookie is not stored over plain
# HTTP, so set false only for a local test on http://127.0.0.1, or sign-in
# appears to succeed and the session silently vanishes.
COOKIE_SECURE=true

# The request thread pool is matched to this, so a busy server queues instead
# of failing. Keep (size + overflow) x api replicas below PostgreSQL's
# max_connections, which defaults to 100.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ------------------------------------------- Running the API directly, no Docker
# Only needed for logic-app/backend/.env.
#
# DATABASE_URL=sqlite:///./logic.db
# DB_AUTO_CREATE=true
# APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEMO_MODE=false
