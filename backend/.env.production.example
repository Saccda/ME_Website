# Copy this file to .env.production on the lab desktop. Never commit that file.
# Leave blank when using compose.production.yml; the container creates and
# persists a strong secret in its private Docker volume.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=me-api.putsaccada.dpdns.org,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=86400

# Keep SQLite for the first low-traffic release. Move to PostgreSQL before
# enabling orders or payments.
DATABASE_URL=

# Replace the Vercel hostname after the first deployment if it differs.
CORS_ALLOWED_ORIGINS=https://me-rupp.vercel.app
CORS_ALLOWED_ORIGIN_REGEXES=^https://me-rupp(?:-[a-z0-9-]+)?\.vercel\.app$
CSRF_TRUSTED_ORIGINS=https://me-api.putsaccada.dpdns.org
WAGTAILADMIN_BASE_URL=https://me-api.putsaccada.dpdns.org

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=me.fe.rupp@gmail.com
CONTACT_NOTIFICATION_EMAIL=me.fe.rupp@gmail.com

GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
